# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ENTRYSENSE_INGEST_KEY: REQUIRED shared secret key for authenticating
# outbound HTTPS pushes from your Remote PC Coordinator or Raspberry Pi 4
# to POST /api/parklabs/sync via:
#   Authorization: Bearer <key>   or   X-API-Key: <key>
# Write endpoints are locked (HTTP 503) whenever this secret is empty so
# public phone users can never modify server state.
ENTRYSENSE_INGEST_KEY=""

# Optional default lot display metadata & IANA timezone for hourly trends
ENTRYSENSE_LOT_NAME="Main Parking Area"
ENTRYSENSE_LOT_CAPACITY="120"
ENTRYSENSE_TIMEZONE="America/Chicago"
