# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Per-publisher ingest secrets (RECOMMENDED):
#   INGEST_KEY_PC only authorizes pushes with "source": "pc"
#   INGEST_KEY_PI only authorizes pushes with "source": "pi"
# Separating keys prevents a compromised Pi from spoofing "source": "pc"
# to bypass the 90s arbitration window, and lets you revoke each key independently.
INGEST_KEY_PC=""
INGEST_KEY_PI=""

# Optional legacy single shared secret (used ONLY when both INGEST_KEY_PC and
# INGEST_KEY_PI are empty). Write endpoints stay locked (HTTP 503) if no key is set.
ENTRYSENSE_INGEST_KEY=""

# Optional default lot display metadata & IANA timezone for hourly trends
ENTRYSENSE_LOT_NAME="Main Parking Area"
ENTRYSENSE_LOT_CAPACITY="120"
ENTRYSENSE_TIMEZONE="America/Chicago"
